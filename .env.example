# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# API key from https://aiforthai.in.th (required)
AIFORTHAI_API_KEY=your_aiforthai_api_key_here

# Port for the backend server
PORT=3001

# Comma-separated list of frontend origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# (Optional) Python executable used to run the Pathumma bridge
# PYTHON_EXECUTABLE=.venv/Scripts/python.exe
